# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build

# Testing & Coverage
/coverage

# Environment variables (keep example only)
.env*
!.env.example

# SQLite & Database files (never commit local databases)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm

# Uploaded user media (keep folder via .gitkeep)
/public/uploads/*
!/public/uploads/.gitkeep

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Vercel deployment metadata
.vercel

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~
